<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ========================================================= -->
    <!-- Properties -->
    <!-- ========================================================= -->

    <!-- Log directory -->
    <property name="LOG_HOME" value="logs"/>

    <!-- Log pattern -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} : %msg%n"/>

    <!-- ========================================================= -->
    <!-- Console Appender -->
    <!-- ========================================================= -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

    </appender>

    <!-- ========================================================= -->
    <!-- Application Log -->
    <!-- ========================================================= -->

    <appender name="APPLICATION"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_HOME}/application.log</file>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!-- application-2026-07-24.1.log.gz -->

            <fileNamePattern>
                ${LOG_HOME}/archive/application-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <!-- Max file size: 10MB -->

            <maxFileSize>10MB</maxFileSize>

            <!-- Max history: 30 days -->

            <maxHistory>30</maxHistory>

            <!-- Total size cap: 1GB -->

            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

    </appender>

    <!-- ========================================================= -->
    <!-- Error Log -->
    <!-- ========================================================= -->

    <appender name="ERROR"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_HOME}/error.log</file>

        <filter
                class="ch.qos.logback.classic.filter.LevelFilter">

            <level>ERROR</level>

            <onMatch>ACCEPT</onMatch>

            <onMismatch>DENY</onMismatch>

        </filter>

        <encoder>

            <pattern>${LOG_PATTERN}</pattern>

            <charset>UTF-8</charset>

        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>

                ${LOG_HOME}/archive/error-%d{yyyy-MM-dd}.%i.log.gz

            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>

            <maxHistory>30</maxHistory>

            <totalSizeCap>500MB</totalSizeCap>

        </rollingPolicy>

    </appender>

    <!-- ========================================================= -->
    <!-- Import History -->
    <!-- ========================================================= -->

    <appender name="HISTORY"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_HOME}/history.log</file>

        <encoder>

            <pattern>

                %d{yyyy-MM-dd HH:mm:ss} %msg%n

            </pattern>

            <charset>UTF-8</charset>

        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>

                ${LOG_HOME}/archive/history-%d{yyyy-MM-dd}.%i.log.gz

            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>

            <maxHistory>90</maxHistory>

            <totalSizeCap>500MB</totalSizeCap>

        </rollingPolicy>

    </appender>

    <!-- ========================================================= -->
    <!-- History Logger -->
    <!-- ========================================================= -->

    <logger name="history"
            level="INFO"
            additivity="false">

        <appender-ref ref="HISTORY"/>

    </logger>

    <!-- ========================================================= -->
    <!-- Spring Framework -->
    <!-- ========================================================= -->

    <logger name="org.springframework"
            level="INFO"/>

    <!-- ========================================================= -->
    <!-- Hibernate -->
    <!-- ========================================================= -->

    <!-- SQL -->

    <logger name="org.hibernate.SQL"
            level="DEBUG"/>

    <!-- Bind Parameters -->

    <logger name="org.hibernate.orm.jdbc.bind"
            level="TRACE"/>

    <!-- Statistics -->

    <logger name="org.hibernate.stat"
            level="DEBUG"/>

    <!-- ========================================================= -->
    <!-- Root Logger -->
    <!-- ========================================================= -->

    <root level="INFO">

        <appender-ref ref="CONSOLE"/>

        <appender-ref ref="APPLICATION"/>

        <appender-ref ref="ERROR"/>

    </root>

</configuration>